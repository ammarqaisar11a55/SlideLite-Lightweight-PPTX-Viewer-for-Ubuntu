  <url type="vcs-browser">https://github.com/ammarqaisar11a55/SlideLite-Lightweight-PPTX-Viewer-for-Ubuntu</url>
  <branding>
    <color type="primary" scheme_preference="light">#a9b3fa</color>
    <color type="primary" scheme_preference="dark">#2a3596</color>
  </branding>
