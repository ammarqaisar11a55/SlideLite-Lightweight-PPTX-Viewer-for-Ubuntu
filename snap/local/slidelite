#!/usr/bin/python3
"""SlideLite launcher inside the snap (the package lives in $SNAP/usr/share/slidelite)."""

import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.environ.get("SNAP", "/"), "usr/share/slidelite"))

from slidelite.cli import main  # noqa: E402

sys.exit(main())
